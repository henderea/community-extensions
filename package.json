    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/chai": "^5.2.3",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "chai": "^6.3.0",
    "cheerio": "^1.2.0",
    "domhandler": "^5.0.3",
    "eslint": "^10.13.0",
    "eslint-config-henderea": "3.0.2",
    "fastest-levenshtein": "^1.0.16",
